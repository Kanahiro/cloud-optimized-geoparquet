{
  "name": "@cogp/reader",
  "version": "2.0.0",
  "description": "Cloud Optimized GeoParquet Profile (COGP) reader for the web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanahiro/cloud-optimized-geoparquet.git",
    "directory": "cogp-js"
  },
  "homepage": "https://github.com/Kanahiro/cloud-optimized-geoparquet",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "vendor"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "hyparquet-compressors": "^1.1.1",
    "lineclip": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@mapbox/vector-tile": "1.3.1",
    "pbf": "3.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
