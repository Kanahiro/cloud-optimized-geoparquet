{
  "name": "@cogp/maplibre",
  "version": "2.1.3",
  "description": "MapLibre GL JS vector tile adapter for Cloud Optimized GeoParquet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanahiro/cloud-optimized-geoparquet.git",
    "directory": "js/packages/maplibre"
  },
  "homepage": "https://github.com/Kanahiro/cloud-optimized-geoparquet",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
